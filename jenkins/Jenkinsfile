node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:16-buster-slim \
            npm install
        '''
    }

    stage('Test') {
        sh """
          docker run --rm \
            -v "${WORKSPACE}:/app" \
            -w /app \
            node:16-buster-slim \
            sh ./jenkins/scripts/test.sh
        """
    }

    stage('Deploy') {
        
    }
}
