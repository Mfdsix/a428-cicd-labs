node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:lts-buster-slim \
            ls -la
        '''
    }

    stage('Test') {
        sh """
          docker run --rm \
            -v "${WORKSPACE}:/app" \
            -w /app \
            node:lts-buster-slim \
            sh ./jenkins/scripts/test.sh
        """
    }

    stage('Manual Approval') {
        input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
    }

    stage('Deliver') {
        sh """
          docker run --rm \
            -v "${WORKSPACE}:/app" \
            -w /app \
            node:lts-buster-slim \
            sh ./jenkins/scripts/deliver.sh
        """

        echo 'Biarkan Aplikasi berjalan selama 1 menit...'
        sleep 60
        
        sh './jenkins/scripts/kill.sh'
    }
}
