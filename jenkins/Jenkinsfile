properties([
    pipelineTriggers([
        pollSCM('H/2 * * * *')
    ])
])

node {
    stage('Checkout') {
        checkout scm
    }

    stage('Build') {
        docker.image('node:lts-buster-slim').inside('--privileged -p 3000:3000 -e DOCKER_TLS_VERIFY=0') {
            withEnv(["CI=true", "DOCKER_TLS_VERIFY=0", "DOCKER_CERT_PATH="]) {
                sh 'npm install'
            }
        }
    }

    stage('Test') {
        sh './jenkins/scripts/test.sh'
    }

    stage('Manual Approval') {
        input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
    }

    stage('Deliver') {
        sh './jenkins/scripts/deliver.sh'
        echo 'Biarkan Aplikasi berjalan selama 1 menit...'
        sleep 60
        sh './jenkins/scripts/kill.sh'
    }
}
