node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:16-buster-slim \
            npm install
        '''
    }

    // stage('Test') {
    //     sh """
    //       docker run --rm \
    //         -v "${WORKSPACE}:/app" \
    //         -w /app \
    //         node:16-buster-slim \
    //         sh ./jenkins/scripts/test.sh
    //     """
    // }

    stage('Deploy') {
        withCredentials([string(credentialsId: 'EC2_PRIVATE_KEY', variable: 'KEY_CONTENT')]) {
            withEnv([
                "EC2_USER=${env.EC2_USER}",
                "EC2_HOST=${env.EC2_HOST}",
                "DEPLOY_PATH=/var/www/react-app"
            ]) {
                // 1. Tulis di home directory (~), folder ini pasti bisa ditulisi oleh user jenkins
                sh 'printf "%s" "$KEY_CONTENT" > ~/ec2_key.pem && chmod 400 ~/ec2_key.pem'

                // 2. Build React (Gunakan quote untuk handle spasi)
                sh "docker run --rm -v \"${WORKSPACE}:/app\" -w /app node:16-buster-slim npm run build"

                // 3. Rsync (Gunakan trik CP & CHMOD di dalam container)
                sh """
                    docker run --rm \
                        -v \"/home/jenkins/ec2_key.pem:/tmp/temp_key:ro\" \
                        -v \"${WORKSPACE}:/app\" \
                        -w /app \
                        instrumentisto/rsync-ssh \
                        sh -c "cp /tmp/temp_key /tmp/key && chmod 400 /tmp/key && rsync -avz --delete -e 'ssh -i /tmp/key -o StrictHostKeyChecking=no' build/ ${EC2_USER}@${EC2_HOST}:${DEPLOY_PATH}/"
                """

                // 4. Reload Nginx pakai container yang sama
                sh """
                    docker run --rm \
                        -v \"/home/jenkins/ec2_key.pem:/tmp/temp_key:ro\" \
                        instrumentisto/rsync-ssh \
                        sh -c "cp /tmp/temp_key /tmp/key && chmod 400 /tmp/key && ssh -i /tmp/key -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} 'sudo systemctl reload nginx'"
                """

                // 5. Cleanup
                sh 'rm -f ~/ec2_key.pem'
            }
        }
    }
}
