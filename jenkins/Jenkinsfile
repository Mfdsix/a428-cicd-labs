pipeline {
    agent {
        docker {
            image 'node:lts-buster-slim'
            args '--privileged -p 3000:3000 -e DOCKER_TLS_VERIFY=0'
        }
    }
    environment {
        CI = 'true'
        DOCKER_TLS_VERIFY = '0'
        DOCKER_CERT_PATH = ''
    }
    stages {
        stage('Build') {
            steps {
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh './jenkins/scripts/test.sh'
            }
        }
        stage('Deliver') {
            steps {
                sh './jenkins/scripts/deliver.sh'
                input message: 'Finished using the website? (Click "Proceed" to continue)'
                sh './jenkins/scripts/kill.sh'
            }
        }
    }
}
