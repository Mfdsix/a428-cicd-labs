node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:16-buster-slim \
            npm install
        '''
    }

    // stage('Test') {
    //     sh """
    //       docker run --rm \
    //         -v "${WORKSPACE}:/app" \
    //         -w /app \
    //         node:16-buster-slim \
    //         sh ./jenkins/scripts/test.sh
    //     """
    // }

    stage('Deploy') {
        // Panggil ID kredensial yang lu buat tadi
        withAWS(credentials: 'aws-creds', region: 'ap-southeast-1') {
            
            // 1. Build
            sh "docker run --rm -v \"${WORKSPACE}:/app\" -w /app node:16-buster-slim npm run build"

            // 2. Zip (Pastikan zip terinstall di Jenkins, kalau nggak pakai container)
            sh "zip -r deploy.zip build/ appspec.yml scripts/"

            // 3. Upload ke S3
            sh "aws s3 cp deploy.zip s3://nama-bucket-lu/deploy.zip"

            // 4. Trigger CodeDeploy
            sh """
                aws deploy create-deployment \
                    --application-name NamaAppLu \
                    --deployment-group-name NamaGroupLu \
                    --s3-location bucket=nama-bucket-lu,key=deploy.zip,bundleType=zip
            """
        }
    }
}
