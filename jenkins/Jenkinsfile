node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:16-buster-slim \
            npm install
        '''
    }

    stage('Test') {
        sh """
          docker run --rm \
            -v "${WORKSPACE}:/app" \
            -w /app \
            node:16-buster-slim \
            sh ./jenkins/scripts/test.sh
        """
    }

    stage('Deploy') {
        withCredentials([string(credentialsId: 'EC2_PRIVATE_KEY', variable: 'KEY_CONTENT')]) {
            withEnv([
                "EC2_USER=${env.EC2_USER}",
                "EC2_HOST=${env.EC2_HOST}",
                "DEPLOY_PATH=/var/www/react-app"
            ]) {
                sh 'echo "$KEY_CONTENT" > ec2_key.pem && chmod 400 ec2_key.pem'

                sh 'docker run --rm -v "$WORKSPACE:/app" -w /app node:16-buster-slim npm run build'

                sh '''
                    docker run --rm \
                        -v "$WORKSPACE:/app" \
                        -w /app \
                        instrumentisto/rsync-ssh \
                        rsync -avz --delete \
                        -e "ssh -i /app/ec2_key.pem -o StrictHostKeyChecking=no" \
                        build/ ${EC2_USER}@${EC2_HOST}:${DEPLOY_PATH}/
                '''

                sh '''
                    ssh -i ec2_key.pem -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} "sudo systemctl reload nginx"
                '''

                sh 'rm -f ec2_key.pem'
            }
        }
    }
}
