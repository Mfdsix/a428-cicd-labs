node {

    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh '''
          docker run --rm \
            -v "$PWD:/app" \
            -w /app \
            node:16-buster-slim \
            npm install
        '''
    }

    stage('Test') {
        sh """
          docker run --rm \
            -v "${WORKSPACE}:/app" \
            -w /app \
            node:16-buster-slim \
            sh ./jenkins/scripts/test.sh
        """
    }

    stage('Deploy') {
        withCredentials([string(credentialsId: 'EC2_PRIVATE_KEY', variable: 'KEY_CONTENT')]) {
            withEnv([
                "EC2_USER=${env.EC2_USER}",
                "EC2_HOST=${env.EC2_HOST}",
                "DEPLOY_PATH=/var/www/react-app"
            ]) {
                // 1. Tulis key ke /tmp agar tidak kena Permission Denied di workspace
                sh 'printf "%s" "$KEY_CONTENT" > /tmp/ec2_key.pem && chmod 400 /tmp/ec2_key.pem'

                // 2. Build React (Gunakan quote untuk handle spasi di nama workspace)
                sh "docker run --rm -v \"${WORKSPACE}:/app\" -w /app node:16-buster-slim npm run build"

                // 3. Rsync (Mount file key dari /tmp host ke /tmp container)
                sh """
                    docker run --rm \
                        -v \"/tmp/ec2_key.pem:/tmp/ec2_key.pem:ro\" \
                        -v \"${WORKSPACE}:/app\" \
                        -w /app \
                        instrumentisto/rsync-ssh \
                        rsync -avz --delete \
                        -e "ssh -i /tmp/ec2_key.pem -o StrictHostKeyChecking=no" \
                        build/ ${EC2_USER}@${EC2_HOST}:${DEPLOY_PATH}/
                """

                // 4. Reload Nginx
                sh "ssh -i /tmp/ec2_key.pem -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} 'sudo systemctl reload nginx'"

                // 5. Cleanup
                sh 'rm -f /tmp/ec2_key.pem'
            }
        }
    }
}
