node {
    stage('Checkout') {
        checkout scm
        sh 'ls -la'
    }

    stage('Build') {
        sh 'docker run --rm -v $PWD:/app -w /app node:lts-buster-slim ls -la'
        sh 'docker pull node:lts-buster-slim'
        sh 'docker run --rm -v $PWD:/app -w /app --pull always node:lts-buster-slim ls -la'
        sh 'docker run --rm -v $PWD:/app node:lts-buster-slim sh -c "mkdir -p /app && ls -la /app"'
        sh 'docker run --rm --privileged -v $PWD:/app -w /app node:lts-buster-slim ls -la'
        sh 'docker run --rm -it -v $PWD:/app -w /app node:lts-buster-slim bash'
    }

    stage('Test') {
        sh './jenkins/scripts/test.sh'
    }

    stage('Manual Approval') {
        input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
    }

    stage('Deliver') {
        sh './jenkins/scripts/deliver.sh'
        echo 'Biarkan Aplikasi berjalan selama 1 menit...'
        sleep 60
        sh './jenkins/scripts/kill.sh'
    }
}
